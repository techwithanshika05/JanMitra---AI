# Copy this to .env inside backend/ and fill in as needed.
# The app runs with zero keys set (retrieval-only mode).

DATABASE_URL=sqlite:///./janmitra.db
CHROMA_DIR=./chroma_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

JWT_SECRET=change-this-in-production

# "gemini" | "openai" | "none"
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=

SARVAM_API_KEY=

GROQ_API_KEY=