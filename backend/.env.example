# Database: PostgreSQL is preferred when reachable; SQLite is the fallback.
DATABASE_URL=
SQLITE_FALLBACK_URL=sqlite:///./janmitra.db
DATABASE_CONNECT_TIMEOUT=3

# Manya RAG: one persistent Chroma directory and matching embedding model.
CHROMA_DIR=./data/vector_db/chroma
CHROMA_COLLECTION=pds_welfare_knowledge
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RETRIEVAL_TOP_K=4
MIN_CONFIDENCE_TO_ANSWER=0.35

GROQ_API_KEY=xyz
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=500
GROQ_TIMEOUT=120

JWT_SECRET=change-this-in-production
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

LIVEKIT_URL=xyz
LIVEKIT_API_KEY=xyz
LIVEKIT_API_SECRET=xyz
VOICE_AGENT_NAME=janmitra-scheme-agent
VOICE_DEFAULT_LANGUAGE=hi-IN
VOICE_ROOM_TTL_MINUTES=30

SARVAM_API_KEY=xyz
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=codemix
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER= shubh
SARVAM_TTS_PACE=0.9
SARVAM_LLM_MODEL=sarvam-105b
